# ============================================================
# 로컬 개발 환경변수 — 실제 값은 .env.local (커밋 금지)
# 나중에 AWS 전환 시 Secrets Manager 로 이전 (lib/config.ts 참조)
# ============================================================

# 표시용 브랜드명 (기본: 펫라이프위드미). 표기 실험·프리뷰 구분이 필요할 때만 덮어쓴다
NEXT_PUBLIC_SITE_NAME=
# 브랜드 태그라인 (기본: "반려동물의 행복한 삶, 나와 함께 - pet life with me", 놀이 토픽은 "즐거운 삶"). 덮어쓰면 토픽 구분 없이 이 문구 하나
NEXT_PUBLIC_SITE_TAGLINE=
# 배포 URL. 로컬은 http://localhost:3000, 운영은 https://petlifewith.me
NEXT_PUBLIC_SITE_URL=
# 사이트 환경: production | preview | local (미설정 시 URL 로 추정)
# dev.petlifewith.me 배포에는 반드시 preview — 실도메인이어도 전면 noindex 가드가 걸린다
NEXT_PUBLIC_SITE_ENV=

# PostgreSQL — docker compose up -d db 기준 기본값
DATABASE_URL=
# Lambda 전환 대비 커넥션 상한 (기본 5)
DB_POOL_MAX=

# 관리자 로그인 토큰 (Cognito 전환 전 임시 인증 — lib/auth.ts 만 교체하면 됨)
# 단일:   ADMIN_TOKEN=<토큰>                        (라벨 admin)
# 다계정: ADMIN_TOKEN=hee:<토큰1>,partner:<토큰2>   (사람별 발급·회수, 패널에 라벨 표시)
# 발급·회수는 scripts/admin-token.ps1 로 한다. 토큰에 콜론·쉼표를 넣지 않는다.
ADMIN_TOKEN=
# 세션 쿠키 서명 시크릿 (32자 이상 무작위 문자열)
AUTH_SECRET=

# 관리자 /admin/deploy 배포 버튼 — GitHub Actions deploy 워크플로 실행용 (시크릿, 배포는 .env.deploy.<stage> 에)
# fine-grained PAT: 이 저장소 하나만, 권한 Actions: Read and write. 비우면 배포 버튼이 꺼진다
GITHUB_DEPLOY_TOKEN=
# (선택) 기본 likethisfeelo/petlifewith.me / main
GITHUB_DEPLOY_REPO=
GITHUB_DEPLOY_REF=

# 오브젝트 스토리지 (로컬은 MinIO, 배포는 S3) — DB에는 오브젝트 키만 저장
# 배포(Lambda)에서는 키를 비워두면 실행 역할(기본 자격 증명 체인)을 쓴다 — sst.config.ts 가 버킷을 주입
# 커스텀 엔드포인트(MinIO)를 쓸 때는 키 두 개가 필수
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# 정적 자산 공개 URL prefix — 버킷까지 포함 (CloudFront 예정, 로컬은 http://localhost:9000/app-media)
NEXT_PUBLIC_ASSET_BASE_URL=
# 페이지별 이미지가 없을 때 쓰는 기본 OG 이미지 (완성 URL, 1200x630 권장)
NEXT_PUBLIC_DEFAULT_OG_IMAGE_URL=

# 애널리틱스·검증 (공개 식별자 — 기본값이 코드에 있고, 여기서 덮어쓰거나 "off" 로 끈다)
# 운영(production)에서만 로드되고 관리자 화면은 제외된다 (web/src/lib/analytics.ts)
NEXT_PUBLIC_GTM_ID=
# GA4 는 GTM 컨테이너 안에서 태그로 설정한다. 아래 값은 GTM 을 끈 경우의 직접 로드 폴백용
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Google AdSense 게시자 ID (ca-pub-…). 운영에서만 로드되고 관리자·포털·/rehab·장묘·약국·B2B·의료 인접 편은 제외
NEXT_PUBLIC_ADSENSE_CLIENT=

# 돌봄 파트너(펫시터·펫산책) 예약 신청 알림 — Slack Incoming Webhook URL (시크릿, hooks.slack.com 으로 시작)
# 비우면 신청은 DB(관리자 /admin/bookings)에만 쌓이고 슬랙 알림은 건너뛴다. 배포는 .env.deploy.<stage> 에 넣는다
SLACK_BOOKING_WEBHOOK_URL=
# 요청함(업체 등록·정보 관리·유료 노출·돌봄 파트너 등록) 알림 웹훅. 비우면 예약 신청 웹훅으로 같이 보낸다
SLACK_REQUESTS_WEBHOOK_URL=

# 공공데이터포털 — API 활용신청 승인 후 입력
DATA_GO_KR_API_KEY=

# 회원 인증 — Cognito (배포는 sst.config.ts 가 자동으로 넣는다. 로컬 개발은 dev 풀 값을 여기에)
# 값은 `pnpm exec sst deploy --stage dev` 출력(userPoolId) 과 AWS 콘솔(앱 클라이언트 AuthWebClient)에서 확인
COGNITO_REGION=ap-northeast-2
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN_URL=
COGNITO_KAKAO_PROVIDER=
# 카카오 로그인 — .env.deploy.<stage> 에 넣으면 배포가 Cognito 에 카카오(OIDC) 공급자를 만든다 (시크릿)
# Kakao Developers: REST API 키 / 클라이언트 시크릿, Redirect URI = 배포 출력 kakaoRedirectUri
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 카카오 지도 (JavaScript 키 — 공개값, 빌드 때 박힌다). 플랫폼 Web 에 사이트·link 도메인 등록 (docs/운영.md 5-9)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# ---------- 검색어 보관 — Google Search Console (docs/운영.md 4-5) ----------
# 서비스 계정 JSON 의 client_email / private_key. 비우면 매일 받기(Cron)가 만들어지지 않는다.
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
# URL 접두어 속성: https://petlifewith.me/ · 도메인 속성: sc-domain:petlifewith.me
GSC_SITE_URL=https://petlifewith.me/
