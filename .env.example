# ============================================================
# 로컬 개발 환경변수 — 실제 값은 .env.local (커밋 금지)
# 나중에 AWS 전환 시 Secrets Manager 로 이전 (lib/config.ts 참조)
# ============================================================

# 표시용 브랜드명 — 브랜드 확정 전까지 환경변수로만 관리 (하드코딩 금지)
NEXT_PUBLIC_SITE_NAME=
# 배포 URL. 로컬은 http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# PostgreSQL — docker compose up -d db 기준 기본값
DATABASE_URL=
# Lambda 전환 대비 커넥션 상한 (기본 5)
DB_POOL_MAX=

# 관리자 로그인 토큰 (로컬 임시 인증 — Cognito 전환 시 lib/auth.ts 만 교체)
ADMIN_TOKEN=
# 세션 쿠키 서명 시크릿 (32자 이상 무작위 문자열)
AUTH_SECRET=

# 오브젝트 스토리지 (로컬은 MinIO, 배포는 S3) — DB에는 오브젝트 키만 저장
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# 정적 자산 공개 URL prefix — 버킷까지 포함 (CloudFront 예정, 로컬은 http://localhost:9000/app-media)
NEXT_PUBLIC_ASSET_BASE_URL=
# 페이지별 이미지가 없을 때 쓰는 기본 OG 이미지 (완성 URL, 1200x630 권장)
NEXT_PUBLIC_DEFAULT_OG_IMAGE_URL=

# 공공데이터포털 — API 활용신청 승인 후 입력
DATA_GO_KR_API_KEY=
